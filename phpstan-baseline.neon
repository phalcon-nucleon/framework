			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#1 \$callback of function set_error_handler expects \(callable\(int, string, string, int\)\: bool\)\|null, Closure\(mixed, mixed, mixed, mixed\)\: void given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#1 \$command of function proc_open expects list\<string\>\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#1 \$process of function proc_terminate expects resource, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#1 \$string of function strlen expects string, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#2 \$code of class Neutrino\\Process\\Exception constructor expects int, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#2 \$descriptor_spec of function proc_open expects array\<1\|2, list\<string\>\|resource\>, array\{1\: resource\|false, 2\: resource\|false\} given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#2 \$offset of function fseek expects int, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#4 \$cwd of function proc_open expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Parameter \#6 \$options of function proc_open expects array\<string, bool\>\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Property Neutrino\\Process\\Process\:\:\$cmd has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/Neutrino/Process/Process.php

