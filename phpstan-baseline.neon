parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Binary operation "\.\=" between mixed and mixed results in an error\.$#'
			identifier: assignOp.invalid
			count: 2
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Call to function is_null\(\) with Neutrino\\Error\\Error will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Cannot access offset ''pid'' on array\|bool\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Cannot access offset ''running'' on array\|bool\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Cannot access offset 1 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Cannot access offset 2 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:__construct\(\) has parameter \$cmd with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:__construct\(\) has parameter \$cwd with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:__construct\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:close\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:exec\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:getError\(\) should return string but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:getOutput\(\) should return string but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:read\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:read\(\) has parameter \$offset with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:read\(\) has parameter \$pipe with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:readError\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:readOutput\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:readStatus\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:readStatus\(\) should return array\|bool but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Method Neutrino\\Process\\Process\:\:wait\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Neutrino/Process/Process.php

