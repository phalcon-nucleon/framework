			identifier: missingType.property
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Property Neutrino\\Process\\Process\:\:\$options has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Property Neutrino\\Process\\Process\:\:\$pipes has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Property Neutrino\\Process\\Process\:\:\$proc has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/Neutrino/Process/Process.php

		-
			message: '#^Property Neutrino\\Process\\Process\:\:\$spec has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/Neutrino/Process/Process.php

		-
