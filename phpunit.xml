<?xml version="1.0" encoding="UTF-8"?>
<!--
  One test suite per module. Only the suites listed in tests/migrated-suites.txt
  run in CI (see bin/phpunit-migrated): each 2.0 epic adds its suites once ported.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Assert">
            <directory>tests/Test/Assert</directory>
        </testsuite>
        <testsuite name="Auth">
            <directory>tests/Test/Auth</directory>
        </testsuite>
        <testsuite name="Cache">
            <directory>tests/Test/Cache</directory>
        </testsuite>
        <testsuite name="Cli">
            <directory>tests/Test/Cli</directory>
        </testsuite>
        <testsuite name="Config">
            <directory>tests/Test/Config</directory>
        </testsuite>
        <testsuite name="Database">
            <directory>tests/Test/Database</directory>
        </testsuite>
        <testsuite name="Debug">
            <directory>tests/Test/Debug</directory>
        </testsuite>
        <testsuite name="Design">
            <directory>tests/Test/Design</directory>
        </testsuite>
        <testsuite name="Dotconst">
            <directory>tests/Test/Dotconst</directory>
        </testsuite>
        <testsuite name="Error">
            <directory>tests/Test/Error</directory>
        </testsuite>
        <testsuite name="Events">
            <directory>tests/Test/Events</directory>
        </testsuite>
        <testsuite name="Facades">
            <directory>tests/Test/Facades</directory>
        </testsuite>
        <testsuite name="Foundation">
            <directory>tests/Test/Foundation</directory>
        </testsuite>
        <testsuite name="Http">
            <directory>tests/Test/Http</directory>
            <exclude>tests/Test/Http/CsrfTest.php</exclude><!-- E8 -->
        </testsuite>
        <testsuite name="Csrf">
            <file>tests/Test/Http/CsrfTest.php</file>
        </testsuite>
        <testsuite name="HttpClient">
            <directory>tests/Test/HttpClient</directory>
        </testsuite>
        <testsuite name="Micro">
            <directory>tests/Test/Micro</directory>
        </testsuite>
        <testsuite name="Middleware">
            <directory>tests/Test/Middleware</directory>
            <exclude>tests/Test/Middleware/MiddlewareDebugTest.php</exclude><!-- E12 -->
            <exclude>tests/Test/Middleware/ThrottleTest.php</exclude><!-- E8 -->
        </testsuite>
        <testsuite name="MiddlewareDebug">
            <file>tests/Test/Middleware/MiddlewareDebugTest.php</file>
        </testsuite>
        <testsuite name="Throttle">
            <file>tests/Test/Middleware/ThrottleTest.php</file>
        </testsuite>
        <testsuite name="Models">
            <directory>tests/Test/Models</directory>
        </testsuite>
        <testsuite name="Optimize">
            <directory>tests/Test/Optimize</directory>
        </testsuite>
        <testsuite name="Process">
            <directory>tests/Test/Process</directory>
        </testsuite>
        <testsuite name="Providers">
            <directory>tests/Test/Providers</directory>
        </testsuite>
        <testsuite name="Repositories">
            <directory>tests/Test/Repositories</directory>
        </testsuite>
        <testsuite name="Security">
            <directory>tests/Test/Security</directory>
        </testsuite>
        <testsuite name="Helpers">
            <file>tests/Test/Support/ArrFuncTest.php</file>
            <file>tests/Test/Support/FuncTest.php</file>
            <file>tests/Test/Support/ObjFuncTest.php</file>
            <file>tests/Test/Support/PathFuncTest.php</file>
            <file>tests/Test/Support/StrFuncTest.php</file>
        </testsuite>
        <testsuite name="Support">
            <directory>tests/Test/Support</directory>
            <exclude>tests/Test/Support/ArrFuncTest.php</exclude>
            <exclude>tests/Test/Support/FuncTest.php</exclude>
            <exclude>tests/Test/Support/ObjFuncTest.php</exclude>
            <exclude>tests/Test/Support/PathFuncTest.php</exclude>
            <exclude>tests/Test/Support/StrFuncTest.php</exclude>
        </testsuite>
        <testsuite name="TestCase">
            <directory>tests/Test/TestCase</directory>
        </testsuite>
        <testsuite name="View">
            <directory>tests/Test/View</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory suffix=".php">src/Neutrino/Debug/resources</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="test"/>
    </php>
</phpunit>
